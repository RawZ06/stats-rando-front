<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <title>Duel — Pots of Time</title>
  <meta name="viewport" content="width=1280, initial-scale=1"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Image de fond avec tout le layout graphique */
    .background-layout {
      background: url('/assets/pot.png') no-repeat center center;
      background-size: cover;
    }

    /* Variables CSS pour les positions */
    :root {
      /* Positions verticales (top) */
      --bracket-top: 80px;
      --round-top: 120px;
      --name-top: 308px;
      --firsts-top: 410px;
      --seconds-top: 480px;
      --thirds-top: 518px;
      --forfeits-top: 556px;
      --score-top: 397px;

      /* Positions horizontales gauche */
      --name-left: 120px;
      --stats-left: 230px;

      /* Positions horizontales droite */
      --name-right: 120px;
      --stats-right: 230px;
    }
  </style>
</head>
<body class="bg-black">

  <!-- Container principal 1280x720 avec l'image de fond -->
  <div class="background-layout w-[1280px] h-[720px] relative mx-auto relative">

    <!-- Bracket et Round/Group -->
    <div class="absolute right-[200px] text-center" style="top: var(--bracket-top)">
      <div class="text-[36px] font-black text-white">
        <%= data.bracket %>
        <% if (data.round) { %>
          <br> Round <%= data.round %>
        <% } else if (data.group) { %>
          <br> Poule <%= data.group %>
        <% } %>
      </div>
    </div>

    <!-- Joueur GAUCHE - Nom dans le panneau blanc -->
    <div class="absolute flex items-center justify-center w-[340px] gap-2" style="top: var(--name-top); left: var(--name-left)">
      <span class="text-[28px] text-center font-bold italic text-[#b67c3a]">
        <%= data.left.name %>
      </span>
    </div>

    <!-- Joueur DROIT - Nom dans le panneau blanc -->
    <div class="absolute flex items-center justify-center w-[340px] gap-2" style="top: var(--name-top); right: var(--name-right)">
      <span class="text-[28px] text-center font-bold italic text-[#b67c3a]">
        <%= data.right.name %>
      </span>
    </div>

    <!-- Joueur GAUCHE - Nom twitch -->
    <div class="absolute flex items-center gap-2" style="top: calc(var(--name-top) + 48px); left: var(--name-left)">
      <span class="text-[18px] text-center font-bold italic text-white">
        <%= data.left.twitch_name %>
      </span>
    </div>

    <!-- Joueur DROIT - Nom twitch -->
    <div class="absolute flex items-center gap-2" style="top: calc(var(--name-top) + 48px); right: var(--name-right)">
      <span class="text-[18px] text-center font-bold italic text-white">
        <%= data.right.twitch_name %>
      </span>
    </div>

    <!-- Joueur GAUCHE - Stats (1ER, 2ÈME, 3ÈME, DNF) -->
    <div class="absolute text-[38px] font-black text-[#b67c3a] h-[52px] w-[100px] text-right flex items-center justify-center" style="top: var(--firsts-top); left: calc(var(--stats-left) + 40px)">
      <%= data.left.firsts %>
    </div>
    <div class="absolute text-[28px] font-black text-[#b67c3a] h-[32px] w-[100px] text-right flex items-center justify-center" style="top: var(--seconds-top); left: var(--stats-left)">
      <%= data.left.seconds %>
    </div>
    <div class="absolute text-[28px] font-black text-[#b67c3a] h-[32px] w-[100px] text-right flex items-center justify-center" style="top: var(--thirds-top); left: var(--stats-left)">
      <%= data.left.thirds %>
    </div>
    <div class="absolute text-[28px] font-black text-[#b67c3a] h-[32px] w-[100px] text-right flex items-center justify-center" style="top: var(--forfeits-top); left: var(--stats-left)">
      <%= data.left.forfeits %>
    </div>

    <!-- Joueur DROIT - Stats (1ER, 2ÈME, 3ÈME, DNF) -->
    <div class="absolute text-[38px] font-black text-[#b67c3a] h-[52px] w-[100px] flex items-center justify-center" style="top: var(--firsts-top); right: calc(var(--stats-right) + 40px)">
      <%= data.right.firsts %>
    </div>
    <div class="absolute text-[28px] font-black text-[#b67c3a] h-[32px] w-[100px] flex items-center justify-center" style="top: var(--seconds-top); right: var(--stats-right)">
      <%= data.right.seconds %>
    </div>
    <div class="absolute text-[28px] font-black text-[#b67c3a] h-[32px] w-[100px] flex items-center justify-center" style="top: var(--thirds-top); right: var(--stats-right)">
      <%= data.right.thirds %>
    </div>
    <div class="absolute text-[28px] font-black text-[#b67c3a] h-[32px] w-[100px] flex items-center justify-center" style="top: var(--forfeits-top); right: var(--stats-right)">
      <%= data.right.forfeits %>
    </div>

    <!-- Graphique circulaire des confrontations -->
    <%
      const totalRaces = data.leftWins + data.rightWins;
      const leftPercentage = totalRaces > 0 ? (data.leftWins / totalRaces) * 100 : 0;
      const pieGradient = `conic-gradient(#4A7C59 0% ${leftPercentage}%, #B8860B ${leftPercentage}% 100%)`;
    %>

    <div class="absolute left-1/2 -translate-x-1/2" style="top: calc(var(--score-top))">
      <!-- Graphique circulaire externe -->
      <div class="flex justify-center w-full">
          <div class="pie-chart" style="background: <%= pieGradient %>; width: 225px; height: 225px; border-radius: 50%; position: relative;">
          <!-- Cercle intérieur marron -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150px] h-[150px] rounded-full bg-[#8B6F47] flex items-center justify-center">
            <!-- Cercle intérieur noir avec le score -->
            <div class="w-[105px] h-[105px] rounded-full bg-black flex items-center justify-center">
              <span class="text-[30px] font-black text-white">
                <%= data.leftWins %> - <%= data.rightWins %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Légendes sous le graphique -->
      <div class="flex justify-center gap-8 mt-3 text-sm font-bold">
        <div class="text-center">
          <div class="text-white mb-1 text-[12px]">VICTOIRES <%= data.left.name.toUpperCase() %></div>
          <div class="text-[18px] text-white"><%= data.leftWins %></div>
        </div>
        <div class="text-center">
          <div class="text-white mb-1 text-[12px]">VICTOIRES <%= data.right.name.toUpperCase() %></div>
          <div class="text-[18px] text-white"><%= data.rightWins %></div>
        </div>
      </div>
    </div>

  </div>

</body>
</html>
