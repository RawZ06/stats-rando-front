<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <title>Stats Globales — Pots of Time</title>
  <meta name="viewport" content="width=1280, initial-scale=1"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'gold-1': '#f2d79b',
            'gold-2': '#ffd9a8',
            'brown-1': '#b67c3a',
            'brown-2': '#7b4c1a',
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-gradient-to-b from-brown-1 to-brown-2 text-white font-sans">

  <!-- Container principal 1280x720 -->
  <div class="w-[1280px] h-[720px] mx-auto py-7 px-7 relative">

    <!-- Cadre décoratif -->
    <div class="absolute inset-[14px] border-2 border-white/35 rounded-[10px] pointer-events-none">
      <!-- Lignes horizontales décoratives -->
      <div class="absolute top-[18px] left-[18px] right-[18px] h-[2px] bg-gradient-to-r from-white/35 via-transparent to-white/35"></div>
      <div class="absolute top-[28px] left-[18px] right-[18px] h-[2px] bg-gradient-to-r from-white/35 via-transparent to-white/35"></div>
    </div>

    <!-- Titre principal -->
    <h1 class="text-center text-[30px] font-black tracking-wide text-gold-2 mb-3.5 drop-shadow-sm">
      Pots of Time — Stats globales
    </h1>

    <!-- Sous-titre -->
    <div class="text-center font-bold text-white/90 -mt-1.5 mb-4">
      Races &amp; Joueurs
    </div>

    <!-- Grille de cartes -->
    <div class="grid grid-cols-3 gap-4">

      <!-- Nombre de races -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Nombre de races</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm">
          <%= g.nbRaces %>
        </div>
      </div>

      <!-- Joueurs (distinct) -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Joueurs (distinct)</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm">
          <%= g.players %>
        </div>
      </div>

      <!-- Joueurs / course (moy.) -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Joueurs / course (moy.)</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm">
          <%= g.avgNumberPlayer %>
        </div>
      </div>

      <!-- Temps moyen -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Temps moyen (HH:MM:SS)</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm font-mono">
          <%= fmt(g.avgTimeSec) %>
        </div>
      </div>

      <!-- Meilleur temps moyen -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Meilleur temps moyen</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm font-mono">
          <%= fmt(g.avgBestTimeSec) %>
        </div>
      </div>

      <!-- Pire temps moyen -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Pire temps moyen</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm font-mono">
          <%= fmt(g.avgWorstTimeSec) %>
        </div>
      </div>

      <!-- Meilleur temps (global) -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Meilleur temps (global)</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm font-mono">
          <%= fmt(g.bestTimeSec) %>
        </div>
      </div>

      <!-- Pire temps (global) -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Pire temps (global)</div>
        <div class="mt-1.5 text-[28px] font-black text-gold-1 drop-shadow-sm font-mono">
          <%= fmt(g.worstTimeSec) %>
        </div>
      </div>

      <!-- Joueurs par course (min / max) -->
      <div class="bg-white/10 border-2 border-white/75 rounded-2xl p-4 text-center backdrop-blur-sm shadow-lg">
        <div class="uppercase tracking-wide text-xs text-white/90">Joueurs par course (min / max)</div>
        <div class="mt-1.5 flex gap-2.5 justify-center">
          <div class="min-w-[120px] bg-white/8 border-2 border-white/75 rounded-full py-2 px-3.5 font-black text-gold-2">
            <%= g.worstNumberPlayer %>
          </div>
          <div class="min-w-[120px] bg-white/8 border-2 border-white/75 rounded-full py-2 px-3.5 font-black text-gold-2">
            <%= g.bestNumberPlayer %>
          </div>
        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="absolute left-7 right-7 bottom-4 flex justify-between items-center text-xs text-white/90">
      <div class="inline-block py-2 px-3.5 border-2 border-white/75 rounded-xl bg-white/8 font-black tracking-wider text-white">
        OOT Randomizer — Pots of Time
      </div>
      <div><%= now %></div>
    </div>

  </div>

</body>
</html>
